  "sources": [
    {
      "id": "S1",
      "title": "Go: Canceling in-progress operations",
      "url": "https://go.dev/doc/database/cancel-operations",
      "basis": "Pass caller context through services to database Context methods; derive timeouts and defer cancellation."
    },
    {
      "id": "S2",
      "title": "Go: Executing transactions",
      "url": "https://go.dev/doc/database/execute-transactions",
      "basis": "Use sql.Tx APIs, deferred rollback, check Commit, avoid base DB operations while in a transaction."
    },
    {
      "id": "S3",
      "title": "database/sql DB.BeginTx",
      "url": "https://pkg.go.dev/database/sql#DB.BeginTx",
      "basis": "Begin uses Background; BeginTx context covers transaction lifetime and cancellation rolls back; Commit may return cancellation/transaction-done errors."
    },
    {
      "id": "S4",
      "title": "sqlc 1.31.1: Using transactions",
      "url": "https://docs.sqlc.dev/en/v1.31.1/howto/transactions.html",
      "basis": "Generated DBTX supports DB or Tx, and WithTx binds Queries to a transaction."
    },
    {
      "id": "S5",
      "title": "Go Code Review Comments: Interfaces",
      "url": "https://go.dev/wiki/CodeReviewComments#interfaces",
      "basis": "Interfaces generally belong with consuming code; constructors usually return concrete implementations; avoid speculative interfaces."
    },
    {
      "id": "S6",
      "title": "Go context package",
      "url": "https://pkg.go.dev/context",
      "basis": "Pass Context explicitly first; avoid storing it in structs; values are for request-scoped metadata rather than optional dependencies."
    },
    {
      "id": "S7",
      "title": "go-sqlite3 v1.14.52 implementation",
      "url": "https://github.com/mattn/go-sqlite3/blob/v1.14.52/sqlite3.go",
      "basis": "Exec interruption and cancellable row stepping; Commit/Rollback use Background internally and Commit attempts rollback on error."
    },
    {
      "id": "S8",
      "title": "go-sqlite3 v1.14.52 context adapter",
      "url": "https://raw.githubusercontent.com/mattn/go-sqlite3/v1.14.52/sqlite3_sql.go",
      "basis": "ExecContext, QueryContext and BeginTx forward context; BeginTx ignores driver.TxOptions and delegates to configured transaction mode."
    },
    {
      "id": "S9",
      "title": "AWS Prescriptive Guidance: Transactional outbox",
      "url": "https://docs.aws.amazon.com/prescriptive-guidance/latest/cloud-design-patterns/transactional-outbox.html",
      "basis": "Persist business change and delivery intent atomically, dispatch after commit, account for duplicate delivery."
    }
  ],
  "findings": [
    {
      "priority": "high",
      "finding": "Cancellation ends at repository ports. All 124 domain operations lack context; production adapter has 242 explicit Background calls, 44 Begin calls, and migration startup adds one Begin.",
      "evidence": [
        "internal/ports/repositories.go:7",
        "internal/adapters/sqlite/repositories/messages.go:36",
        "internal/adapters/sqlite/repositories/contacts.go:87",
        "internal/adapters/sqlite/migrations/migrate.go:14"
      ],
      "recommendation": "Thread context.Context as the first parameter through I/O ports, helpers, generated queries and BeginTx(ctx,nil). Choose request/connection/command/startup contexts at operation boundaries, not inside repositories.",
      "sources": [
        "S1",
        "S3",
        "S6"
      ]
    },
    {
      "priority": "high",
      "finding": "Modern service context checks are only before the application mutex. ChatGroups, ChatHistory, SyncChat, MarkChatRead, SendChatMessage and ContactsSnapshot can proceed after cancellation while waiting for the lock, then hold the lock during storage I/O.",
      "evidence": [
        "internal/services/history.go:10",
        "internal/services/transcripts.go:31",
        "internal/services/transcripts.go:94",
